# Copy to .env.local for local development. Never commit real values.

# Public base URL of the platform (used for metadata, sitemap and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string (32+ characters) used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# "mock" uses demo data for every infrastructure adapter. "live" uses real providers (Phase 3).
ADAPTER_MODE=mock

