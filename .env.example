# Copy to .env.local for local development. Never commit real values.

# Public base URL of the platform (used for metadata, sitemap and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string (32+ characters) used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# "mock" uses demo data for every infrastructure adapter. "live" uses real providers.
# When unset: live if DATABASE_URL is set, mock otherwise. Real clients must never see demo data.
# ADAPTER_MODE=mock

# Postgres connection string. Leave empty to run on the built-in sample database
# (in-process, sample data, reset on every restart). Set it for real client data.
# DATABASE_URL=postgres://user:password@host:5432/zaffre
# Neon: the direct (non-pooled) URL, used for migrations because they hold an advisory lock.
# DATABASE_URL_UNPOOLED=
# Set to "false" to skip migrating on start, when `npm run db:migrate` runs in the build instead.
# DATABASE_AUTO_MIGRATE=false

# With a real, empty database: the first admin is created for this email on first start
# and gets a one-time link to choose a password.
# ADMIN_EMAIL=
# ADMIN_NAME=

# Public address used in emailed links (password reset, invites). Defaults to the deploy URL.
# APP_URL=https://app.example.com

# How many proxies sit in front of the app (Traefik on our own server = 1). Used to read the
# real client IP for rate limits and sign-in records. Not needed on Vercel.
# TRUSTED_PROXY_HOPS=1

# Resend API key for platform emails. Without it, emails are recorded but NOT sent, and the
# server logs an error at start. Required before taking real clients.
# RESEND_API_KEY=
# EMAIL_FROM=Zaffre <no-reply@example.com>

# --- Live infrastructure (used only when ADAPTER_MODE=live) ---
# Each provider switches on when its settings are present. A provider without settings
# shows "not connected"; live mode never falls back to demo data. See docs/RUNBOOK-SERVER.md.
# COOLIFY_API_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# Hostname clients point their domains at (Cloudflare for SaaS fallback origin):
# EDGE_HOSTNAME=edge.example.com
# Optional: an IP for root domains whose DNS can't flatten a CNAME:
# EDGE_APEX_IP=
# UPTIMEROBOT_API_KEY=

# --- Later (not used yet) ---
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# UPTIMEROBOT_API_KEY=
# MIGADU_API_USER=
# MIGADU_API_KEY=
