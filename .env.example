# Copy to .env.local for local development. Never commit real values.

# Public base URL of the platform (used for metadata, sitemap and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string (32+ characters) used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# "mock" uses demo data for every infrastructure adapter. "live" uses real providers (Phase 3).
ADAPTER_MODE=mock

# Postgres connection string. Leave empty to run on the built-in sample database
# (in-process, sample data, reset on every restart). Set it for real client data.
# DATABASE_URL=postgres://user:password@host:5432/zaffre

# With a real, empty database: the first admin is created for this email on first start
# and gets a one-time link to choose a password.
# ADMIN_EMAIL=
# ADMIN_NAME=

# Public address used in emailed links (password reset, invites). Defaults to the deploy URL.
# APP_URL=https://app.example.com

# Resend API key for platform emails. Without it, emails are recorded but not sent.
# RESEND_API_KEY=
# EMAIL_FROM=Zaffre <no-reply@example.com>

# --- Phase 3 (not used yet) ---
# COOLIFY_API_URL=
# COOLIFY_API_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# UPTIMEROBOT_API_KEY=
# MIGADU_API_USER=
# MIGADU_API_KEY=
